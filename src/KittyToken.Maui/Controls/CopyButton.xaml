<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KittyToken.Maui.Controls.CopyButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KittyToken.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="CopyButtonControl"
    x:DataType="controls:CopyButton">
    <ImageButton
        x:Name="ImageButton"
        BindingContext="{Binding Source={x:Reference CopyButtonControl}}"
        Clicked="ImageButton_Clicked"
        Source="copy.png">
        <ImageButton.Behaviors>
            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        </ImageButton.Behaviors>
    </ImageButton>
</ContentView>
