<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KittyToken.Maui.Controls.IconButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KittyToken.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="IconButtonControl"
    x:DataType="controls:IconButton">
    <Border
        Padding="14,10"
        BindingContext="{Binding Source={x:Reference IconButtonControl}}"
        MinimumHeightRequest="44"
        MinimumWidthRequest="44"
        StrokeShape="RoundRectangle 8"
        StrokeThickness="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
        </Border.GestureRecognizers>

        <HorizontalStackLayout Spacing="8">
            <Image
                HeightRequest="18"
                Source="{Binding ImageSource}"
                VerticalOptions="Center"
                WidthRequest="18">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{Binding TextColor, Source={x:Reference TextLabel}, x:DataType=Label}" />
                </Image.Behaviors>
            </Image>

            <Label
                x:Name="TextLabel"
                Text="{Binding Text}"
                VerticalOptions="Center">
                <Label.Style>
                    <Style TargetType="Label">
                        <Setter Property="FontFamily" Value="OpenSansRegular" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                        <Style.Triggers>
                            <DataTrigger
                                x:DataType="controls:IconButton"
                                Binding="{Binding IsEnabled}"
                                TargetType="Label"
                                Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray400}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Label.Style>
            </Label>
        </HorizontalStackLayout>
    </Border>
</ContentView>
