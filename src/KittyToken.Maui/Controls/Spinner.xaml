<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KittyToken.Maui.Controls.Spinner"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:drawables="clr-namespace:KittyToken.Maui.Drawables"
    x:Name="SpinnerControl">
    <GraphicsView x:Name="GraphicsView">
        <GraphicsView.Drawable>
            <drawables:SpinnerDrawable
                x:Name="SpinnerDrawableLocal"
                BindingContext="{Binding Source={x:Reference SpinnerControl}}"
                EndAngle="90"
                PrimaryColor="{Binding PrimaryColor}"
                SecondaryColor="{Binding SecondaryColor}"
                Size="{Binding Size}"
                StartAngle="90"
                Thickness="{Binding Thickness}" />
        </GraphicsView.Drawable>
    </GraphicsView>
</ContentView>
