<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KittyToken.Maui.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:azureAdModels="clr-namespace:KittyToken.Application.AzureAd.Models;assembly=KittyToken.Application"
    xmlns:controls="clr-namespace:KittyToken.Maui.Controls"
    xmlns:models="clr-namespace:KittyToken.Maui.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:KittyToken.Maui.Views"
    Title=""
    x:DataType="views:MainPage">

    <ContentPage.Resources>
        <toolkit:IsEqualConverter x:Key="IsEqualConverter" />

        <toolkit:IsNotEqualConverter x:Key="IsNotEqualConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="250,*,*">
        <Grid
            Grid.Column="0"
            Padding="20"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                              Dark={StaticResource Gray900}}"
            RowDefinitions="Auto,*"
            RowSpacing="12">
            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                Text="Files" />

            <CollectionView Grid.Row="1" ItemsSource="{Binding AzureAdFiles}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="azureAdModels:AzureAdFile">
                        <Label Padding="0,8" Text="{Binding Name}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="20" Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Instance" />
                        <Entry Text="{Binding Configuration.Instance, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tenant Id" />
                        <Entry Text="{Binding Configuration.TenantId, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Client Id" />
                        <Entry Text="{Binding Configuration.ClientId, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Client Secret" />
                        <Entry Text="{Binding Configuration.ClientSecret, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Scope" />
                        <Entry Text="{Binding Configuration.Scope, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" Margin="20">
                <Button
                    Clicked="GetAccessTokenButton_Clicked"
                    IsEnabled="{Binding GetAccessTokenButtonIsEnabled}"
                    IsVisible="{Binding VisualizationState, Converter={StaticResource IsNotEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.Loading}}"
                    Text="Run" />
                <!--<Button.Triggers>
                       <DataTrigger
                           Binding="{Binding IsLoading}"
                           TargetType="Button"
                           Value="True">
                           <Setter Property="IsVisible" Value="False" />
                       </DataTrigger>
                   </Button.Triggers>-->

                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource Secondary},
                                                      Dark={StaticResource Gray600}}"
                    Clicked="CancelButton_Clicked"
                    IsVisible="{Binding VisualizationState, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.Loading}}"
                    Text="Cancel"
                    TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource White}}" />
            </Grid>
        </Grid>

        <Grid Grid.Column="2" Padding="20">
            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding VisualizationState, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.Idle}}"
                Spacing="20"
                VerticalOptions="Center">
                <Image Source="cat.png" WidthRequest="100" />

                <Label HorizontalTextAlignment="Center" Text="Enter Azure AD configuration and click Run to get an access token" />
            </VerticalStackLayout>

            <VerticalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding VisualizationState, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.Loading}}"
                Spacing="20"
                VerticalOptions="Center">
                <controls:Spinner
                    HorizontalOptions="Center"
                    IsRunning="{Binding VisualizationState, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.Loading}}"
                    PrimaryColor="{StaticResource Primary}"
                    SecondaryColor="{StaticResource Secondary}"
                    Size="60" />

                <Label HorizontalTextAlignment="Center" Text="Sending request ..." />
            </VerticalStackLayout>

            <controls:JwtVisualizer
                DecodedToken="{Binding DecodedAccessToken}"
                IsVisible="{Binding VisualizationState, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static models:MainPageVisualizationState.ShowToken}}"
                Token="{Binding AccessToken}" />
        </Grid>
    </Grid>

</ContentPage>
